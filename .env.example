# ============================================================
# SIH26032 — Smart Farmer Procurement System
# Backend Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Database (SQLite — just a file path)
DB_PATH=./data/sih26032.db

# Twilio (optional — SMS will be logged to console if not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VOICE_NUMBER=   # Can be same as TWILIO_FROM_NUMBER if voice-enabled

# Backend public URL (used by Twilio to form callback URLs)
BACKEND_URL=

# OTP (in dev mode OTPs are returned in the API response for testing)
OTP_EXPIRY_MINUTES=10

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
